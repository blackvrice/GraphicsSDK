# Official amalgamated source integration. Competitor checkouts are never patched.
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/competitors/bgfx-build.lock.json" bgfx_lock)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/competitors/bgfx-build.lock.json")
set(bgfx_identity "")
foreach(dep bgfx bx bimg)
  string(JSON dep_dir GET "${bgfx_lock}" dependencies ${dep} directory)
  string(JSON dep_sha GET "${bgfx_lock}" dependencies ${dep} commit)
  set(${dep}_source "${CMAKE_CURRENT_SOURCE_DIR}/../${dep_dir}")
  execute_process(COMMAND git -C "${${dep}_source}" rev-parse HEAD OUTPUT_VARIABLE actual_sha
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND git -C "${${dep}_source}" status --porcelain --untracked-files=no
    OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT actual_sha STREQUAL dep_sha OR dirty)
    message(FATAL_ERROR "Unpinned or modified bgfx dependency: ${dep}")
  endif()
  string(APPEND bgfx_identity "${dep}|${dep_sha}\n")
endforeach()
file(GLOB_RECURSE bgfx_bench_sources CONFIGURE_DEPENDS
  "${CMAKE_CURRENT_SOURCE_DIR}/*.cpp" "${CMAKE_CURRENT_SOURCE_DIR}/*.hpp" "${CMAKE_CURRENT_SOURCE_DIR}/*.cmake")
list(APPEND bgfx_bench_sources "${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt")
list(SORT bgfx_bench_sources)
foreach(source IN LISTS bgfx_bench_sources)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(SHA256 "${source}" digest)
  file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}/.." "${source}")
  string(APPEND bgfx_identity "${relative}|${digest}\n")
endforeach()
string(SHA256 bgfx_fingerprint "${bgfx_identity}")
add_library(bench_bx STATIC "${bx_source}/src/amalgamated.cpp")
target_include_directories(bench_bx PUBLIC "${bx_source}/include" "${bx_source}/include/compat/msvc" PRIVATE "${bx_source}/3rdparty")
target_compile_definitions(bench_bx PUBLIC BX_CONFIG_DEBUG=0)
add_library(bench_bimg STATIC "${bimg_source}/src/image.cpp")
target_include_directories(bench_bimg PUBLIC "${bimg_source}/include")
target_compile_definitions(bench_bimg PRIVATE BIMG_CONFIG_DECODE_ASTC=0)
target_link_libraries(bench_bimg PUBLIC bench_bx)
target_compile_options(bench_bx PUBLIC /Zc:__cplusplus /Zc:preprocessor)
add_library(bench_bgfx STATIC "${bgfx_source}/src/amalgamated.cpp" competitors/BgfxBuild.cpp)
target_include_directories(bench_bgfx PUBLIC "${bgfx_source}/include" PRIVATE "${bgfx_source}/3rdparty")
target_compile_definitions(bench_bgfx PRIVATE BGFX_CONFIG_RENDERER_DIRECT3D12=1 BGFX_CONFIG_MULTITHREADED=0
  BGFX_CONFIG_VIDEO=0 BGFX_CONFIG_MAX_DRAW_CALLS=131072 GFX_BGFX_BUILD_SHA256="${bgfx_fingerprint}")
target_link_libraries(bench_bgfx PUBLIC bench_bimg PRIVATE gdi32 psapi)
foreach(target bench_bx bench_bimg bench_bgfx)
  # Upstream bx uses SEH for Windows thread naming and is built without C++ unwinding.
  target_compile_options(${target} PRIVATE /W3 /EHs-c- /utf-8 /bigobj)
  target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
  set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
  set_property(TARGET ${target} PROPERTY INTERPROCEDURAL_OPTIMIZATION FALSE)
endforeach()
target_sources(gfx_bench PRIVATE competitors/Bgfx.cpp)
target_compile_definitions(gfx_bench PRIVATE GFX_BENCH_HAS_BGFX=1)
target_link_libraries(gfx_bench PRIVATE bench_bgfx)
enable_testing()
add_executable(bgfx_shader_contracts tests/BgfxShaderTests.cpp common/Shaders.cpp)
target_include_directories(bgfx_shader_contracts PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_compile_options(bgfx_shader_contracts PRIVATE /W4 /EHsc /utf-8)
target_compile_definitions(bgfx_shader_contracts PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(bgfx_shader_contracts PRIVATE d3dcompiler)
add_test(NAME bgfx_shader_contracts COMMAND bgfx_shader_contracts)
