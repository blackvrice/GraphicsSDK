# Preserve the exact generated audit text checked by --check across Git checkouts.
/licenses/generated/** text eol=lf
/licenses/policy.json text eol=lf
# Keep the original quoted license text, including its whitespace.
/licenses/generated/**/THIRD_PARTY_NOTICES.txt whitespace=-blank-at-eol,-blank-at-eof
/licenses/provenance/d3dx12-upstream-LICENSE.txt -text whitespace=cr-at-eol,-blank-at-eof
# These files have byte hashes in the measured evidence. Do not normalize them.
/benchmarks/results/2026-10-20-diligent-*/** -text whitespace=cr-at-eol
/benchmarks/reports/2026-10-20-diligent/** -text whitespace=cr-at-eol
/benchmarks/reports/validation/2026-10-20-diligent/** -text whitespace=cr-at-eol
