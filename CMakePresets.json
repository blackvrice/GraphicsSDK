{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name": "windows", "generator": "Visual Studio 17 2022", "architecture": "x64", "binaryDir": "${sourceDir}/out/core", "cacheVariables": {"GFX_ENABLE_D3D12": "ON", "GFX_BUILD_TESTS": "ON", "GFX_BUILD_EXAMPLES": "ON"}},
    {"name": "portable-core", "generator": "Ninja", "binaryDir": "${sourceDir}/out/portable", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "GFX_ENABLE_D3D12": "OFF", "GFX_BUILD_TESTS": "ON", "GFX_BUILD_EXAMPLES": "OFF"}}
  ],
  "buildPresets": [{"name": "windows-release", "configurePreset": "windows", "configuration": "Release"}, {"name": "portable-core", "configurePreset": "portable-core"}],
  "testPresets": [{"name": "windows-release", "configurePreset": "windows", "configuration": "Release", "output": {"outputOnFailure": true}}, {"name": "portable-core", "configurePreset": "portable-core", "output": {"outputOnFailure": true}}]
}
